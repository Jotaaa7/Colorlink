# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SUPABASE: Configuration for Supabase PostgreSQL Database & Auth.
# Get these values from your Supabase project settings (Project Settings > API).
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""
# RENDER POSTGRESQL / DATABASE_URL:
# When creating a PostgreSQL database on Render, copy the "Internal Database URL"
# (or External Database URL if connecting remotely) and set it here.
# Render automatically injects this into linked Web Services if connected.
DATABASE_URL="postgresql://colorlink_user:password@dpg-xxxx-a.oregon-postgres.render.com/colorlink_db"

# EMAIL NOTIFICATIONS (Bienvenida, Factura de Compra, Cambio de Estado de Proyecto):
#
# 👉 OPCIÓN 1: RESEND (RECOMENDADA)
# Crea tu cuenta gratuita en https://resend.com, crea una API Key y colócala en Render:
RESEND_API_KEY="re_123456789_abcdefg"
# Opcional si ya verificaste tu propio dominio en Resend (por defecto usa onboarding@resend.dev):
# RESEND_FROM="ColorLink Pintuco <notificaciones@tu-dominio.com>"

# 👉 OPCIÓN 2 (Alternativa): SMTP Tradicional (Gmail, Brevo, SendGrid)
# Si no usas Resend, puedes usar SMTP estándar configurando:
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="587"
# SMTP_SECURE="false"
# SMTP_USER="tu-correo@gmail.com"
# SMTP_PASS="tu-contraseña-de-aplicacion"
# SMTP_FROM="ColorLink Pintuco <notificaciones@pintuco.com>"


